{
  "manifest_version": 3,
  "name": "VeriSight",
  "version": "2.0",
  "description": "Herramienta avanzada con red Two-Stream (Espacial y Frecuencial) para la detección de rostros Deepfake.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox.html",
        "sandbox.js",
        "opencv.js",
        "ort.wasm.min.js",
        "ort-wasm.wasm",
        "ort-wasm-simd.wasm",
        "ort-wasm-threaded.wasm",
        "ort-wasm-simd-threaded.mjs",
        "ort-wasm-simd.mjs",
        "ort-wasm-simd-threaded.wasm",
        "onnx_model/model_twostream.onnx"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}